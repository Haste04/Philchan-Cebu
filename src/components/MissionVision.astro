---
/**
 * MissionVision.astro
 * Features two modern overlapping cards highlighting the organization's core tenets.
 */
import { Compass, Eye, Heart, CheckCircle2 } from "@lucide/astro";

const missionPoints = [
  "Coordinate care, formation and accompaniment of people living with HIV and AIDS, health/medical personnel, and pastoral/spiritual workers;",
  "Facilitate training and development programs on the prevention, monitoring and management of the disease;",
  "Network with other supporters for continuous growth and sustainability;",
  "Strengthen capabilities and motivation of the members of the Network;",
  "Lead by giving a voice to the human rights of PLHIV, eliminating stigma and discrimination, and empowering them to live with the dignity, and;",
  "Create an environment of open, responsive, and comprehensive exchange of communication and information on the fight against HIV and AIDS.",
];

const visionText =
  "To be the dynamic bastion of healing and hope committed to bringing the everlasting love of God to people living with and affected by HIV/AIDS and help create an HIV-free society.";
---

<section
  id="mission-vision"
  class="relative bg-gradient-to-b from-health-white to-health-bg py-24 sm:py-32 overflow-hidden"
>
  <div class="mx-auto max-w-content px-6 relative z-10">
    <div class="mb-16 text-center max-w-3xl mx-auto reveal">
      <div
        class="inline-flex items-center gap-2 rounded-full bg-health-white border border-health-green/10 px-5 py-2 text-sm font-bold tracking-wide uppercase text-health-green shadow-sm"
      >
        <Compass class="h-4 w-4" />
        Our Purpose
      </div>
      <h2
        class="mt-8 font-display text-5xl sm:text-6xl font-bold tracking-tight text-health-text"
      >
        Guided by Faith & Care
      </h2>
    </div>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-8 max-w-6xl mx-auto">
      <!-- Mission Card -->
      <div
        class="relative flex flex-col justify-between glass-card p-10 sm:p-14 lg:translate-y-8 reveal-left delay-200 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl"
      >
        <div>
          <div class="flex items-center gap-6">
            <div
              class="flex h-16 w-16 items-center justify-center rounded-3xl bg-health-red text-white shadow-md"
            >
              <Heart class="h-8 w-8" />
            </div>
            <h3 class="font-display text-4xl font-bold text-health-text">
              Mission
            </h3>
          </div>

          <ul class="mt-8 space-y-4">
            {
              missionPoints.map((point) => (
                <li class="flex items-start gap-3.5 text-base sm:text-lg text-health-text/80 font-medium leading-relaxed">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-health-red/10 text-health-red">
                    <CheckCircle2 class="h-4 w-4" />
                  </span>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="mt-12 flex items-center gap-3 text-sm font-bold uppercase tracking-wider text-health-text/40 border-t border-health-border/50 pt-8"
        >
          <Heart class="h-5 w-5 text-health-red" />
          Care and Compassion in Action
        </div>
      </div>

      <!-- Vision Card -->
      <div
        class="relative flex flex-col justify-between glass-card p-10 sm:p-14 lg:-translate-y-8 reveal-right delay-400 transition-all duration-500 hover:-translate-y-2 lg:hover:-translate-y-10 hover:shadow-2xl"
      >
        <div>
          <div class="flex items-center gap-6">
            <div
              class="flex h-16 w-16 items-center justify-center rounded-3xl bg-health-green text-white shadow-md"
            >
              <Eye class="h-8 w-8" />
            </div>
            <h3 class="font-display text-4xl font-bold text-health-text">
              Vision
            </h3>
          </div>

          <div
            class="mt-8 flex items-start gap-3.5 text-lg sm:text-xl text-health-text/80 font-medium leading-relaxed"
          >
            <span
              class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-health-green/10 text-health-green"
            >
              <CheckCircle2 class="h-5 w-5" />
            </span>
            <span>{visionText}</span>
          </div>
        </div>

        <div
          class="mt-12 flex items-center gap-3 text-sm font-bold uppercase tracking-wider text-health-text/40 border-t border-health-border/50 pt-8"
        >
          <Eye class="h-5 w-5 text-health-green" />
          A Future Built on Dignity
        </div>
      </div>
    </div>
  </div>
</section>
