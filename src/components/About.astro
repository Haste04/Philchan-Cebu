---
/**
 * About.astro
 * "Who is PhilCHAN?" - short organizational background with modern styling.
 */
import { Heart, Users, CheckCircle } from "@lucide/astro";

const facts = [
  {
    stat: "2013",
    label: "Founded by the Catholic Bishops' Conference of the Philippines",
  },
  {
    stat: "10+",
    label: "Years supporting people living with HIV/AIDS in Visayas",
  },
  {
    stat: "100%",
    label: "Free testing, counseling, and pastoral care - no cost, ever",
  },
];
---

<section
  id="about"
  class="glass-section transition-colors duration-300 py-16 lg:py-24"
>
  <div class="section-container relative z-10">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-20 items-center">
      <div class="reveal-left">
        <h2
          class="text-4xl sm:text-5xl font-display font-bold text-health-text tracking-tight"
        >
          Who is PhilCHAN Cebu?
        </h2>
        <div class="h-1.5 w-20 bg-health-red rounded-full mt-6 mb-8"></div>
        <p class="text-health-text/80 text-xl leading-relaxed font-medium">
          PhilCHAN Cebu, also known as the Philippine Catholic HIV/AIDS Network
          Inc., is a dedicated faith-based organization committed to combating
          the HIV/AIDS epidemic. With a focus on providing support, education,
          and advocacy, PhilCHAN Cebu strives to empower individuals and
          communities affected by this health crisis, fostering a compassionate
          environment rooted in love and understanding. Through various programs
          and initiatives, the organization promotes awareness, prevention, and
          access to treatment, ensuring that no one faces the challenges of
          HIV/AIDS alone.
        </p>
        <p class="mt-6 text-health-text/80 text-xl leading-relaxed font-medium">
          We work alongside parishes, the Department of Health, and local
          government units to close gaps in access to testing and reduce the
          stigma that keeps people from seeking care.
        </p>
      </div>

      <dl class="grid grid-cols-1 gap-6 sm:grid-cols-3 lg:grid-cols-1">
        {
          facts.map((fact, index) => (
            <div
              class={`glass-card p-8 transition-transform duration-300 hover:-translate-y-2 reveal-right delay-${(index + 1) * 100}`}
            >
              <dt class="font-display text-5xl font-bold text-health-green">
                {fact.stat}
              </dt>
              <dd class="mt-4 text-lg font-medium text-health-text/70 leading-relaxed">
                {fact.label}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="mt-24 divider-ribbon opacity-80 reveal delay-300"></div>
  </div>
</section>
