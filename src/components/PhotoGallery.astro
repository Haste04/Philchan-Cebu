---
import { galleryImages } from "../data/galleryData";
---

<section class="photo-gallery-section" aria-label="Photo gallery">
  {
    galleryImages.length === 0 ? (
      <div class="text-center py-16 px-6">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-health-green-pale mb-6">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-health-green"
          >
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
            <circle cx="12" cy="13" r="3" />
          </svg>
        </div>
        <p class="text-xl text-health-text/60 font-medium max-w-md mx-auto leading-relaxed">
          Photos coming soon — check back for images from our outreach events across Cebu.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {galleryImages.map((image, index) => (
          <div
            class="photo-card reveal group"
            style={`--n: ${index}; animation-delay: ${index * 150}ms`}
          >
            <div class="relative overflow-hidden rounded-2xl aspect-[4/3] mb-4">
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-health-green text-white text-xs font-bold tracking-wide shadow-md">
                {image.location}
              </span>
            </div>
            <p class="text-health-text font-medium leading-relaxed">{image.description}</p>
            {image.date && (
              <p class="text-sm text-health-text/50 mt-1">{image.date}</p>
            )}
          </div>
        ))}
      </div>
    )
  }
</section>

<style>
  .photo-card {
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s ease;
  }
  .photo-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 12px 40px rgba(44, 94, 72, 0.1),
      0 4px 12px rgba(44, 94, 72, 0.05);
  }
</style>
